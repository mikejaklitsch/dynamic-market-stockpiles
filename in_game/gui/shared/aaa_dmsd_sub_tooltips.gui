# ═══════════════════════════════════════════════════════════════════════════════
# SUB-TOOLTIPS FOR DEMAND BREAKDOWN
# ═══════════════════════════════════════════════════════════════════════════════
# Applied via "using = template_name" on value text_single widgets.
# Each wraps a tooltipwidget + ContextualTooltipType block.
# Uses GetPlayer for country scope since these are always player-facing.

# ─── Per-slider spending inefficiency ───
# Separate template per slider because efficiency is now based on each
# slider's raw gold, not a shared country-wide economic base.

template dmsd_court_efficiency_tooltip {
	tooltipwidget = {
		ContextualTooltipType = {
			blockoverride "tooltip_title" { }
			blockoverride "tooltip_content" {
				TooltipListBase = {
					blockoverride "block_title" { raw_text = "#T Spending Inefficiency#!" }
					TooltipManualTableField = {
						text_single = { layoutpolicy_horizontal = expanding raw_text = "Raw Slider Gold" }
						expand = { }
						text_single = { raw_text = "[GetPlayer.MakeScope.ScriptValue('dmsd_tt_court_raw')|2]@gold!" }
					}
					TooltipManualTableField = {
						text_single = { layoutpolicy_horizontal = expanding raw_text = "Inefficiency Baseline" }
						expand = { }
						text_single = { raw_text = "[GetPlayer.MakeScope.ScriptValue('dmsd_tt_eff_baseline')|0]@gold!" }
					}
					TooltipManualTableField = {
						text_single = { layoutpolicy_horizontal = expanding raw_text = "× 0.75 per doubling above" }
						expand = { }
						text_single = { raw_text = " " }
					}
					TooltipManualTableField = {
						text_single = { layoutpolicy_horizontal = expanding raw_text = "#bold = Demand Efficiency#!" }
						expand = { }
						text_single = { raw_text = "#bold [GetPlayer.MakeScope.ScriptValue('dmsd_tt_court_efficiency_pct')|1]%#!" }
					}
				}
			}
		}
	}
}

